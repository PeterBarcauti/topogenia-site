{
  "format": "topogenia-collection",
  "version": "1.0",
  "name": "Planning",
  "description": "The most common way to draw up the production plan and calculate requirements, to adapt to your organisation.",
  "processes": [
    {
      "format": "topogenia",
      "version": "1.5",
      "project": {
        "name": "Building the production plan and calculating requirements",
        "code": "PLNREQ",
        "language": "en",
        "description": "Gallery template: building the production plan and calculating requirements. Trigger: A new industrial planning cycle opens. Outcome: Firm production schedule and supply requirements issued. To adapt to your organisation: actors, documents, media, thresholds and lead times."
      },
      "map": {
        "summary": {
          "text": "The commercial department consolidates demand, the planner builds the schedule, load is checked, then the requirements calculation produces the firm orders."
        },
        "lanes": [
          {
            "id": "commercial-department",
            "name": "Commercial department",
            "type": "department"
          },
          {
            "id": "industrial-planner",
            "name": "Industrial planner",
            "type": "person"
          },
          {
            "id": "planning-system",
            "name": "Planning system",
            "type": "system"
          },
          {
            "id": "production-manager",
            "name": "Production manager",
            "type": "person"
          },
          {
            "id": "industrial-management",
            "name": "Industrial management",
            "type": "person"
          }
        ],
        "steps": [
          {
            "id": "new-planning-cycle-opened",
            "lane": "commercial-department",
            "label": "New planning cycle opened",
            "type": "start",
            "column": 0
          },
          {
            "id": "consolidate-demand-forecasts-order-book",
            "lane": "commercial-department",
            "label": "Consolidate the demand forecasts and the order book",
            "column": 1,
            "sheet": {
              "purpose": "The commercial department consolidates the firm orders and the commercial forecasts over the planning horizon to establish the overall forecast demand.",
              "inputs": [
                {
                  "name": "Customer order book",
                  "medium": "spreadsheet"
                },
                {
                  "name": "Order history",
                  "medium": "spreadsheet"
                }
              ],
              "outputs": [
                {
                  "id": "doc-consolidated-demand-plan",
                  "name": "Consolidated demand plan",
                  "medium": "spreadsheet"
                }
              ]
            }
          },
          {
            "id": "draw-up-draft-master-production",
            "lane": "industrial-planner",
            "label": "Draw up the draft master production schedule",
            "column": 2,
            "sheet": {
              "purpose": "The industrial planner turns the demand plan into quantities to produce by family and by reference, taking into account available stock and safety stock targets.",
              "inputs": [
                {
                  "name": "Stock policy",
                  "medium": "file"
                }
              ],
              "uses": [
                {
                  "document": "doc-consolidated-demand-plan"
                }
              ],
              "outputs": [
                {
                  "id": "doc-draft-master-schedule",
                  "name": "Draft master schedule",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "assess-load-capacity-critical-materials",
            "lane": "production-manager",
            "label": "Assess the load, capacity and critical materials",
            "column": 3,
            "sheet": {
              "purpose": "The production manager compares the resulting load with the workshop capacities (machines, labour, tooling) and checks the availability of critical materials and supplier capacities.",
              "inputs": [
                {
                  "name": "Workshop and key supplier capacities",
                  "medium": "spreadsheet"
                }
              ],
              "uses": [
                {
                  "document": "doc-draft-master-schedule"
                },
                {
                  "document": "doc-adjusted-draft-schedule"
                }
              ],
              "outputs": [
                {
                  "id": "doc-load-capacity-materials-assessment",
                  "name": "Load, capacity and materials assessment",
                  "medium": "spreadsheet"
                }
              ]
            }
          },
          {
            "id": "capacity-materials-allow-schedule",
            "lane": "production-manager",
            "label": "Do the capacity and materials allow the schedule?",
            "type": "decision",
            "column": 4,
            "sheet": {
              "uses": [
                {
                  "document": "doc-load-capacity-materials-assessment"
                }
              ]
            }
          },
          {
            "id": "levelling-priority-adjustment-enough",
            "lane": "industrial-planner",
            "label": "Is a levelling or priority adjustment enough?",
            "type": "decision",
            "column": 9,
            "sheet": {
              "free_text": "As applicable: Exception review (if shortage).",
              "uses": [
                {
                  "document": "doc-load-capacity-materials-assessment"
                },
                {
                  "document": "doc-exception-review"
                }
              ]
            }
          },
          {
            "id": "adjust-schedule-arbitrate-priorities",
            "lane": "industrial-planner",
            "label": "Adjust the schedule or arbitrate priorities",
            "column": 11,
            "sheet": {
              "purpose": "In case of an overload that can be handled within the current framework, or following management's arbitration, the planner levels the schedule, arbitrates priorities or uses the capacity levers selected before a new check.",
              "free_text": "As applicable: Exception review (if shortage) ; Arbitration decision (if escalated).",
              "uses": [
                {
                  "document": "doc-load-capacity-materials-assessment"
                },
                {
                  "document": "doc-draft-master-schedule"
                },
                {
                  "document": "doc-exception-review"
                },
                {
                  "document": "doc-arbitration-decision"
                }
              ],
              "outputs": [
                {
                  "id": "doc-adjusted-draft-schedule",
                  "name": "Adjusted draft schedule",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "validate-master-production-schedule",
            "lane": "industrial-planner",
            "label": "Validate the master production schedule",
            "column": 5,
            "sheet": {
              "purpose": "Once load-capacity and materials are balanced, the planner validates the master production schedule with the production manager; it serves as the official reference for the requirements calculation.",
              "uses": [
                {
                  "document": "doc-draft-master-schedule"
                },
                {
                  "document": "doc-adjusted-draft-schedule"
                },
                {
                  "document": "doc-load-capacity-materials-assessment"
                }
              ],
              "outputs": [
                {
                  "id": "doc-validated-master-schedule",
                  "name": "Validated master schedule",
                  "medium": "spreadsheet"
                }
              ]
            }
          },
          {
            "id": "run-net-requirements-calculation",
            "lane": "planning-system",
            "label": "Run the net requirements calculation",
            "column": 6,
            "automation": "automated",
            "sheet": {
              "purpose": "The planning system explodes the bills of materials, deducts existing stocks and work in progress, then generates the proposed manufacturing and purchase orders and the alerts.",
              "inputs": [
                {
                  "name": "Bills of materials",
                  "medium": "file"
                },
                {
                  "name": "Stock and work-in-progress status",
                  "medium": "spreadsheet"
                }
              ],
              "uses": [
                {
                  "document": "doc-validated-master-schedule"
                }
              ],
              "outputs": [
                {
                  "id": "doc-order-proposals",
                  "name": "Order proposals",
                  "medium": "spreadsheet"
                },
                {
                  "id": "doc-exception-messages",
                  "name": "Exception messages",
                  "medium": "spreadsheet"
                }
              ]
            }
          },
          {
            "id": "analyse-exception-messages-shortages",
            "lane": "industrial-planner",
            "label": "Analyse the exception messages and shortages",
            "column": 7,
            "sheet": {
              "purpose": "The planner reviews the exception messages (progress, postponement, cancellation, potential shortage) and identifies blocking hazards.",
              "uses": [
                {
                  "document": "doc-order-proposals"
                },
                {
                  "document": "doc-exception-messages"
                }
              ],
              "outputs": [
                {
                  "id": "doc-exception-review",
                  "name": "Exception review",
                  "medium": "spreadsheet"
                }
              ]
            }
          },
          {
            "id": "critical-shortages-require-schedule-revised",
            "lane": "industrial-planner",
            "label": "Do critical shortages require the schedule to be revised?",
            "type": "decision",
            "column": 8,
            "sheet": {
              "uses": [
                {
                  "document": "doc-exception-review"
                }
              ]
            }
          },
          {
            "id": "firm-up-orders-over-frozen",
            "lane": "industrial-planner",
            "label": "Firm up the orders over the frozen horizon",
            "column": 9,
            "row": 1,
            "sheet": {
              "purpose": "With no critical shortage calling the schedule into question, the planner converts the proposals in the firm zone into firm manufacturing orders and purchase requests.",
              "uses": [
                {
                  "document": "doc-order-proposals"
                },
                {
                  "document": "doc-exception-review"
                }
              ],
              "outputs": [
                {
                  "id": "doc-firm-manufacturing-orders",
                  "name": "Firm manufacturing orders",
                  "medium": "software"
                },
                {
                  "id": "doc-firm-purchase-requests",
                  "name": "Firm purchase requests",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "issue-orders-forecasts-downstream-departments",
            "lane": "planning-system",
            "label": "Issue the orders and forecasts to downstream departments",
            "column": 10,
            "automation": "automated",
            "sheet": {
              "purpose": "The system makes the firm orders available to production scheduling and to procurement, and sends the rolling forecasts to the suppliers.",
              "uses": [
                {
                  "document": "doc-firm-manufacturing-orders"
                },
                {
                  "document": "doc-firm-purchase-requests"
                }
              ],
              "outputs": [
                {
                  "id": "doc-production-schedule",
                  "name": "Production schedule",
                  "medium": "spreadsheet"
                },
                {
                  "id": "doc-supply-programme",
                  "name": "Supply programme",
                  "medium": "spreadsheet"
                }
              ]
            }
          },
          {
            "id": "production-plan-supply-requirements-issued",
            "lane": "industrial-planner",
            "label": "Production plan and supply requirements issued",
            "type": "end",
            "column": 11,
            "row": 1
          },
          {
            "id": "arbitrate-between-demand-capacity",
            "lane": "industrial-management",
            "label": "Arbitrate between demand and capacity",
            "column": 10,
            "sheet": {
              "purpose": "When levelling is not enough, industrial management arbitrates between demand and capacity (customer priorities, extra capacity, subcontracting, postponed orders) and passes its decision to the planner.",
              "free_text": "As applicable: Exception review (if shortage).",
              "uses": [
                {
                  "document": "doc-load-capacity-materials-assessment"
                },
                {
                  "document": "doc-exception-review"
                }
              ],
              "outputs": [
                {
                  "id": "doc-arbitration-decision",
                  "name": "Arbitration decision",
                  "medium": "software"
                }
              ]
            }
          }
        ],
        "flows": [
          {
            "source": "new-planning-cycle-opened",
            "target": "consolidate-demand-forecasts-order-book"
          },
          {
            "source": "consolidate-demand-forecasts-order-book",
            "target": "draw-up-draft-master-production"
          },
          {
            "source": "draw-up-draft-master-production",
            "target": "assess-load-capacity-critical-materials"
          },
          {
            "source": "assess-load-capacity-critical-materials",
            "target": "capacity-materials-allow-schedule"
          },
          {
            "source": "capacity-materials-allow-schedule",
            "target": "validate-master-production-schedule",
            "label": "yes"
          },
          {
            "source": "capacity-materials-allow-schedule",
            "target": "levelling-priority-adjustment-enough",
            "label": "no"
          },
          {
            "source": "levelling-priority-adjustment-enough",
            "target": "adjust-schedule-arbitrate-priorities",
            "label": "yes"
          },
          {
            "source": "levelling-priority-adjustment-enough",
            "target": "arbitrate-between-demand-capacity",
            "label": "no"
          },
          {
            "source": "adjust-schedule-arbitrate-priorities",
            "target": "assess-load-capacity-critical-materials"
          },
          {
            "source": "validate-master-production-schedule",
            "target": "run-net-requirements-calculation"
          },
          {
            "source": "run-net-requirements-calculation",
            "target": "analyse-exception-messages-shortages"
          },
          {
            "source": "analyse-exception-messages-shortages",
            "target": "critical-shortages-require-schedule-revised"
          },
          {
            "source": "critical-shortages-require-schedule-revised",
            "target": "levelling-priority-adjustment-enough",
            "label": "yes"
          },
          {
            "source": "critical-shortages-require-schedule-revised",
            "target": "firm-up-orders-over-frozen",
            "label": "no"
          },
          {
            "source": "firm-up-orders-over-frozen",
            "target": "issue-orders-forecasts-downstream-departments"
          },
          {
            "source": "issue-orders-forecasts-downstream-departments",
            "target": "production-plan-supply-requirements-issued"
          },
          {
            "source": "arbitrate-between-demand-capacity",
            "target": "adjust-schedule-arbitrate-priorities"
          }
        ]
      },
      "uncertainties": [
        "Generic model: replace the actors, the documents and their media with those of your organisation.",
        "Duration and lead time of each step: to be measured in your organisation, the model gives none.",
        "Business and operations planning upstream: in many companies, this process sits under a monthly management arbitration cycle that aligns demand, production, stocks and finance.",
        "Pull flow: for items managed under a pull flow with cards or consumption call-offs, replenishment is made directly on actual consumption without going through the classic requirements calculation.",
        "Supplier integration: in certain sectors, net supply requirements feed rolling delivery schedules sent periodically to suppliers by electronic data interchange.",
        "Event-driven replanning: a major disruption (long breakdown, supplier shortage, urgent order) may trigger a targeted re-run of the requirements calculation outside the normal cycle.",
        "Medium of each document (paper, email, spreadsheet, file, software): set by default in this model, to be adapted to your organisation."
      ]
    }
  ]
}
