{
  "format": "topogenia-collection",
  "version": "1.0",
  "name": "Inbound logistics",
  "description": "The most common receiving process, from the arrival of a supplier delivery to putting it into stock, to adapt to your organisation.",
  "processes": [
    {
      "format": "topogenia",
      "version": "1.5",
      "project": {
        "name": "Receipt of a supplier delivery and put-away",
        "code": "RECV",
        "language": "en",
        "description": "Gallery template: receipt of a supplier delivery and put-away. Trigger: Supplier delivery presented at the receiving dock. Outcome: Goods available in stock; delivery refused at the dock; or goods blocked in quarantine. To adapt to your organisation: actors, documents, media, thresholds and lead times."
      },
      "map": {
        "summary": {
          "text": "The receiving clerk checks the delivery at the dock, refuses it or accepts and records it with any reservations, and any quality inspection comes before put-away."
        },
        "lanes": [
          {
            "id": "supplier-carrier",
            "name": "Supplier / Carrier",
            "type": "department"
          },
          {
            "id": "receiver",
            "name": "Receiver",
            "type": "person"
          },
          {
            "id": "quality-inspector",
            "name": "Quality inspector",
            "type": "person"
          },
          {
            "id": "warehouse-operator-forklift",
            "name": "Warehouse operator / Forklift driver",
            "type": "person"
          }
        ],
        "steps": [
          {
            "id": "supplier-delivery-presented-dock",
            "lane": "supplier-carrier",
            "label": "Supplier delivery presented at the dock",
            "type": "start",
            "column": 0
          },
          {
            "id": "present-documents-unload-goods",
            "lane": "supplier-carrier",
            "label": "Present the documents and unload the goods",
            "column": 1,
            "sheet": {
              "purpose": "The carrier presents the delivery note at the dock, unloads the parcels or pallets into the inspection waiting area and stays until the delivery note is signed.",
              "outputs": [
                {
                  "id": "doc-supplier-delivery-note",
                  "name": "Supplier delivery note",
                  "medium": "paper"
                },
                {
                  "id": "doc-unloaded-goods",
                  "name": "Unloaded goods",
                  "medium": "other"
                }
              ]
            }
          },
          {
            "id": "check-delivery-quantity-visible-condition",
            "lane": "receiver",
            "label": "Check the delivery for quantity and visible condition",
            "column": 2,
            "sheet": {
              "purpose": "In the carrier's presence, the receiving clerk compares references and quantities with the purchase order and the delivery note, and checks the apparent condition of the packaging; a minor difference does not justify a refusal and will be entered as a reservation.",
              "inputs": [
                {
                  "name": "Purchase order",
                  "medium": "software"
                }
              ],
              "uses": [
                {
                  "document": "doc-supplier-delivery-note"
                },
                {
                  "document": "doc-unloaded-goods"
                }
              ],
              "outputs": [
                {
                  "id": "doc-receipt-findings",
                  "name": "Receipt findings",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "delivery-acceptable-dock",
            "lane": "receiver",
            "label": "Is the delivery acceptable at the dock?",
            "type": "decision",
            "column": 3,
            "sheet": {
              "inputs": [
                {
                  "name": "Purchase order",
                  "medium": "software"
                }
              ],
              "uses": [
                {
                  "document": "doc-receipt-findings"
                }
              ]
            }
          },
          {
            "id": "refuse-delivery-state-reason",
            "lane": "receiver",
            "label": "Refuse the delivery and state the reason",
            "column": 4,
            "sheet": {
              "purpose": "In case of an obvious error of consignee, no matching order or major damage making the delivery unusable, the receiving clerk refuses to take charge of it and writes the detailed reason for the refusal on the delivery note.",
              "uses": [
                {
                  "document": "doc-receipt-findings"
                },
                {
                  "document": "doc-supplier-delivery-note"
                }
              ],
              "outputs": [
                {
                  "id": "doc-annotated-delivery-note",
                  "name": "Annotated delivery note",
                  "medium": "paper"
                }
              ]
            }
          },
          {
            "id": "countersign-annotated-delivery-note",
            "lane": "supplier-carrier",
            "label": "Countersign the annotated delivery note",
            "column": 5,
            "sheet": {
              "purpose": "The carrier countersigns the annotated delivery note to record the refusal and its reason on both sides, then takes the goods back.",
              "uses": [
                {
                  "document": "doc-annotated-delivery-note"
                }
              ],
              "outputs": [
                {
                  "id": "doc-countersigned-delivery-note",
                  "name": "Countersigned delivery note",
                  "medium": "paper"
                }
              ]
            }
          },
          {
            "id": "record-receipt-label-lots",
            "lane": "receiver",
            "label": "Record the receipt and label the lots",
            "column": 4,
            "row": 1,
            "sheet": {
              "purpose": "For any accepted delivery, the receiving clerk signs the carrier's delivery note, with any reservations, records the receipt as blocked or unrestricted according to the inspection plan, known on receipt, and prints the lot labels.",
              "inputs": [
                {
                  "name": "Purchase order",
                  "medium": "software"
                },
                {
                  "name": "Receiving inspection plan",
                  "medium": "spreadsheet"
                }
              ],
              "uses": [
                {
                  "document": "doc-supplier-delivery-note"
                },
                {
                  "document": "doc-receipt-findings"
                }
              ],
              "outputs": [
                {
                  "id": "doc-goods-receipt-note",
                  "name": "Goods receipt note",
                  "medium": "software"
                },
                {
                  "id": "doc-traceability-labels",
                  "name": "Traceability labels",
                  "medium": "paper"
                }
              ]
            }
          },
          {
            "id": "quality-check-receipt-required",
            "lane": "receiver",
            "label": "Is a quality check on receipt required?",
            "type": "decision",
            "column": 5,
            "sheet": {
              "inputs": [
                {
                  "name": "Receiving inspection plan",
                  "medium": "spreadsheet"
                }
              ],
              "uses": [
                {
                  "document": "doc-goods-receipt-note"
                }
              ]
            }
          },
          {
            "id": "inspect-goods-received",
            "lane": "quality-inspector",
            "label": "Inspect the goods received",
            "column": 6,
            "sheet": {
              "purpose": "The quality inspector carries out the documentary checks (material certificates, certificates of conformity) and the physical checks set out in the receiving inspection plan, and decides on release.",
              "inputs": [
                {
                  "name": "Technical specifications",
                  "medium": "file"
                }
              ],
              "uses": [
                {
                  "document": "doc-goods-receipt-note"
                },
                {
                  "document": "doc-traceability-labels"
                }
              ],
              "outputs": [
                {
                  "id": "doc-receiving-inspection-report",
                  "name": "Receiving inspection report",
                  "medium": "file"
                }
              ]
            }
          },
          {
            "id": "lot-received-meet-specifications",
            "lane": "quality-inspector",
            "label": "Does the lot received meet the specifications?",
            "type": "decision",
            "column": 7,
            "sheet": {
              "free_text": "Produced as applicable: Release decision (if yes).",
              "uses": [
                {
                  "document": "doc-receiving-inspection-report"
                }
              ],
              "outputs": [
                {
                  "id": "doc-release-decision",
                  "name": "Release decision",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "isolate-non-conforming-lot-quarantine",
            "lane": "quality-inspector",
            "label": "Isolate the non-conforming lot in the quarantine area",
            "column": 8,
            "sheet": {
              "purpose": "In case of non-conformity, the quality inspector keeps the batch blocked in the system, moves it to the quarantine area and opens a non-conformity record.",
              "uses": [
                {
                  "document": "doc-receiving-inspection-report"
                },
                {
                  "document": "doc-traceability-labels"
                }
              ],
              "outputs": [
                {
                  "id": "doc-quarantine-order",
                  "name": "Quarantine order",
                  "medium": "software"
                },
                {
                  "id": "doc-non-conformity-sheet",
                  "name": "Non-conformity sheet",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "put-goods-away-confirm-movement",
            "lane": "warehouse-operator-forklift",
            "label": "Put the goods away and confirm the movement",
            "column": 8,
            "sheet": {
              "purpose": "The storekeeper takes the pallets or parcels to the assigned location and confirms the put-away, making the goods available in stock.",
              "free_text": "As applicable: Release decision (if a check is required).",
              "uses": [
                {
                  "document": "doc-goods-receipt-note"
                },
                {
                  "document": "doc-traceability-labels"
                },
                {
                  "document": "doc-release-decision"
                }
              ],
              "outputs": [
                {
                  "id": "doc-validated-put-away-movement",
                  "name": "Validated put-away movement",
                  "medium": "software"
                }
              ]
            }
          },
          {
            "id": "goods-available-stock",
            "lane": "warehouse-operator-forklift",
            "label": "Goods available in stock",
            "type": "end",
            "column": 9
          },
          {
            "id": "goods-blocked-quarantine-quality-handling",
            "lane": "quality-inspector",
            "label": "Goods blocked in quarantine for quality handling",
            "type": "end",
            "column": 9
          },
          {
            "id": "delivery-refused-dock-taken-back",
            "lane": "supplier-carrier",
            "label": "Delivery refused at the dock and taken back by the carrier",
            "type": "end",
            "column": 6
          }
        ],
        "flows": [
          {
            "source": "supplier-delivery-presented-dock",
            "target": "present-documents-unload-goods"
          },
          {
            "source": "present-documents-unload-goods",
            "target": "check-delivery-quantity-visible-condition"
          },
          {
            "source": "check-delivery-quantity-visible-condition",
            "target": "delivery-acceptable-dock"
          },
          {
            "source": "delivery-acceptable-dock",
            "target": "record-receipt-label-lots",
            "label": "yes"
          },
          {
            "source": "delivery-acceptable-dock",
            "target": "refuse-delivery-state-reason",
            "label": "no"
          },
          {
            "source": "refuse-delivery-state-reason",
            "target": "countersign-annotated-delivery-note"
          },
          {
            "source": "countersign-annotated-delivery-note",
            "target": "delivery-refused-dock-taken-back"
          },
          {
            "source": "record-receipt-label-lots",
            "target": "quality-check-receipt-required"
          },
          {
            "source": "quality-check-receipt-required",
            "target": "inspect-goods-received",
            "label": "yes"
          },
          {
            "source": "quality-check-receipt-required",
            "target": "put-goods-away-confirm-movement",
            "label": "no"
          },
          {
            "source": "inspect-goods-received",
            "target": "lot-received-meet-specifications"
          },
          {
            "source": "lot-received-meet-specifications",
            "target": "put-goods-away-confirm-movement",
            "label": "yes"
          },
          {
            "source": "lot-received-meet-specifications",
            "target": "isolate-non-conforming-lot-quarantine",
            "label": "no"
          },
          {
            "source": "isolate-non-conforming-lot-quarantine",
            "target": "goods-blocked-quarantine-quality-handling"
          },
          {
            "source": "put-goods-away-confirm-movement",
            "target": "goods-available-stock"
          }
        ]
      },
      "uncertainties": [
        "Generic model: replace the actors, the documents and their media with those of your organisation.",
        "Duration and lead time of each step: to be measured in your organisation, the model gives none.",
        "Acceptance with minor reservations: when the difference found at the dock is partial (a missing parcel or slightly damaged packaging that does not make the batch unusable), the delivery follows the accepted path: the receiving clerk enters the reservations on the delivery note, which the carrier countersigns, records the receipt for the conforming quantities and reports the difference to purchasing.",
        "Advance shipping notice: in certain sectors and in large logistics chains, an electronic shipping notice received beforehand allows quick receipt by simply scanning the parcel labels.",
        "Direct availability: some items not held in stock or supplied just in time are taken directly to the requesting department or the line side after the receipt is recorded.",
        "Accounting matching: the recorded goods receipt note serves as the reference for the accounting department for the later matching of the supplier invoice.",
        "Medium of each document (paper, email, spreadsheet, file, software): set by default in this model, to be adapted to your organisation."
      ]
    }
  ]
}
